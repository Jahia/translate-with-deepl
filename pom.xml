<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.1.2.0</version>
    </parent>

    <groupId>org.jahia.community.modules</groupId>
    <artifactId>translate-with-deepl</artifactId>
    <name>Translate with DeepL</name>
    <version>1.4.2-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>UI to get the content translated by DeepL</description>
    <scm>
        <connection>scm:git:git@github.com:Jahia/translate-with-deepl.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/translate-with-deepl.git</developerConnection>
        <url>https://github.com/Jahia/translate-with-deepl</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <jahia-depends>default,content-editor=4.0.0</jahia-depends>
        <jahia.plugin.version>6.9</jahia.plugin.version>
        <yarn.arguments>build:production</yarn.arguments>
        <require-capability>osgi.extender;filter:="(osgi.extender=org.jahia.bundles.blueprint.extender.config)"</require-capability>
        <jahia-deploy-on-site>system</jahia-deploy-on-site>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.deepl.api</groupId>
            <artifactId>deepl-java</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.14.1</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>ps-releases</id>
            <url>https://devtools.jahia.com/nexus/content/repositories/jahia-professional-services-private-repository</url>
        </repository>
        <snapshotRepository>
            <id>ps-snapshots</id>
            <url>https://devtools.jahia.com/nexus/content/repositories/jahia-professional-services-private-repository</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Import-Package>
                            javax.crypto.spec;resolution:=optional,
                            javax.crypto;resolution:=optional,
                            javax.jcr.nodetype;version="[2.0,3)",
                            javax.jcr.observation;version="[2.0,3)",
                            javax.jcr;version="[2.0,3)",
                            javax.naming.directory;resolution:=optional,
                            javax.naming.ldap;resolution:=optional,
                            javax.naming;resolution:=optional,
                            javax.net.ssl;resolution:=optional,
                            javax.net;resolution:=optional,
                            javax.security.auth.x500;resolution:=optional,
                            javax.servlet.http;version="[3.0,4)",
                            javax.servlet;version="[3.0,4)",
                            org.apache.avalon.framework.logger;resolution:=optional,
                            org.apache.commons.collections;version="[3.2,4)",
                            org.apache.commons.lang;version="[2.6,3)",
                            org.apache.log4j;resolution:=optional,
                            org.apache.log;resolution:=optional,
                            org.apache.naming.java,
                            org.ietf.jgss;resolution:=optional,
                            org.jahia.ajax.gwt.client.widget.toolbar.action,
                            org.jahia.bin,
                            org.jahia.data.templates,
                            org.jahia.defaults.config.spring,
                            org.jahia.exceptions,
                            org.jahia.osgi,
                            org.jahia.services,
                            org.jahia.services.content,
                            org.jahia.services.content.decorator,
                            org.jahia.services.content.nodetypes,
                            org.jahia.services.render,
                            org.jahia.services.sites,
                            org.jahia.services.uicomponents.bean,
                            org.jahia.services.uicomponents.bean.editmode,
                            org.jahia.services.uicomponents.bean.toolbar,
                            org.jahia.services.usermanager,
                            org.jahia.utils,
                            org.jahia.utils.i18n,
                            org.json,
                            org.osgi.framework;version="[1.8,2)",
                            org.slf4j;version="[1.7,2)",
                            org.springframework.beans.factory;version="[3.2,4)",
                            org.springframework.beans;version="[3.2,4)",
                            org.springframework.context;version="[3.2,4)",
                            sun.misc;resolution:=optional,
                            sun.nio.ch;resolution:=optional
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>src/main/resources/javascript/apps</directory>
                            <includes>
                                <include>*</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <!-- executions go here -->
                <executions>
                    <execution>
                        <id>npm install node and yarn</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-yarn</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v18.20.2</nodeVersion>
                            <yarnVersion>v1.22.22</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>yarn post-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <yarn.arguments>webpack</yarn.arguments>
            </properties>
        </profile>
    </profiles>
</project>
